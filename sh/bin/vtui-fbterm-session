#!/usr/bin/env bash
#
# vtui-fbterm-session - launch the framebuffer terminal session
#
# Paints ${FBTERM_BG} (a raw /dev/fb0 dump, see vtui-fbterm-genbg) onto the
# framebuffer if set, then execs fbterm running an auto-attach tmux session.
# Invoked from ~/.profile on /dev/tty${FBTERM_TTY:-2}.
#
# Environment:
#   FBTERM_BG            path to a raw fb0 dump (per-machine, ~/.profile.local)
#   FBTERM_TMUX_SESSION  tmux session name (default: tty)
#
# Note: detaching tmux exits fbterm; with getty autologin on the VT, the
# session respawns and re-attaches immediately (by design — immortal session).
#
# Design: ~/Documents/notes/docs/plans/2026-07-04-cli-boot-fbterm-design.md

if [ -n "${FBTERM_BG:-}" ] && [ -r "${FBTERM_BG}" ]; then
	cat "${FBTERM_BG}" > /dev/fb0 2>/dev/null
fi
export FBTERM_BACKGROUND_IMAGE=1

# console-init race guard (kept from the original tty1 setup)
sleep .5

# Guard against the "*:RGB grey bug": a truecolor GUI session (cage + foot /
# brave / ptyxis) leaks a wildcard `*:RGB` into the shared tmux server. Because
# `*` matches fbterm too, tmux then hands fbterm standard truecolor escapes
# (\e[48;2..m) it can't parse (fbterm speaks private \e[2;N} seqs), so every
# background renders as color-8 grey. The root writer is a runtime `set -ag`
# we've never pinned down (it recurs after using cage); rather than chase it,
# self-heal: reset the color features on the already-running server *before*
# this client attaches, so fbterm always starts clean. Guarded on an existing
# server so a fresh boot doesn't double-source the config.
# (Diagnosed 2026-07-23; matching note in ~/.tmux.conf. Removing *:RGB needs a
#  full feature reset — targeted `fbterm:RGB@`/`Tc@` overrides do NOT beat it.)
if tmux has-session 2>/dev/null; then
	tmux set -gu terminal-features \; source-file "${HOME}/.tmux.conf" 2>/dev/null
fi

# TERM=fbterm (256-color terminfo) for the tmux client — the inherited
# TERM=linux would put tmux in 8-color mode (unreadable styling).
# -u COLORTERM: strip any inherited COLORTERM=truecolor. Proven 2026-07-23 to be
# a SECOND, independent path to the grey bug — tmux grants the client RGB from
# COLORTERM just as *:RGB would. fbterm is 256-color; it must not advertise
# truecolor by EITHER path, so we close both here (features reset above, env here).
exec fbterm -- env -u COLORTERM TERM=fbterm tmux new-session -A -s "${FBTERM_TMUX_SESSION:-tty}"
