#!/usr/bin/env bash
# clip.gpaste — GPaste D-Bus clipboard backend.
#
# gpaste-client talks to the GPaste daemon over D-Bus (fast, reliable). It used
# to be the preferred GNOME backend, but per the Task B decision clip.wl is now
# the chosen primary (it alone offers rich/image, and the dispatcher's timeout +
# fallback covers wl stalls). gpaste is kept as a lower-priority PLAIN-ONLY
# fallback: it scores 50 on GNOME, below clip.wl's 70, so it only wins when wl
# is unavailable (no wl-* binaries) or when wl fails and the dispatcher falls
# back to it.
#
# Provider contract (executable, +x):
#   probe        -> "score N" then (if usable) "caps ..."
#   get <type>   -> print clipboard content of <type> to stdout
#   set <type>   -> store stdin as clipboard content of <type>
#
# This provider does NOT need clip::real_binary: gpaste-client is not one of
# our shims, so there is no recursion risk. It does need the dispatcher lib for
# clip::dbus_has_owner (see probe).
source "$(dirname "$(readlink -f "$0")")/../lib/clip.sh"

probe() {
  : 'Self-rate this backend.

      @stdout "score N"; then "caps get:plain set:plain" when usable.
      @return 0 always (an unusable backend still prints "score 0")
  '
  command -v gpaste-client >/dev/null 2>&1 || { echo "score 0"; return; }
  # Liveness, NOT environment. This probe used to run `gpaste-client --version`,
  # which asks D-Bus to activate the daemon; where the daemon cannot start (a VT
  # with no graphical session) that blocks for the full 25s bus timeout. micro
  # reads and writes the clipboard on startup, so it paid that four times over —
  # the ~100s "hang" this check exists to prevent. NameHasOwner asks the bus what
  # it already knows: ~20ms, and it never activates anything.
  #
  # Deliberately NOT gated on $DISPLAY/$WAYLAND_DISPLAY, which would look like
  # the obvious cheap test and is what clip.wl/clip.xsel do. Those vars are
  # process environment, frozen at pane-creation time inside tmux. In a tmux
  # session shared across a GUI and VTs, a pane opened in a VT keeps empty
  # display vars for the life of the pane — so an env gate would score this
  # provider 0 even with a GNOME session up and gpaste-daemon perfectly usable,
  # silently killing the clipboard rather than hanging it. Daemon liveness stays
  # true across VT switches because it never consults the environment at all.
  clip::dbus_has_owner org.gnome.GPaste || { echo "score 0"; return; }
  local score=40
  [[ "$XDG_CURRENT_DESKTOP" == *GNOME* ]] && score=50   # fallback, below clip.wl (70)
  echo "score $score"
  echo "caps get:plain set:plain"
}

main() {
  : 'Provider entrypoint.

      @arg $1 subcommand (probe|get|set)
      @arg $2 type (plain)
  '
  case "$1" in
    probe) probe ;;
    get)   [[ "$2" == plain ]] && gpaste-client --use-index get 0 ;;
    set)   [[ "$2" == plain ]] && gpaste-client add "$(cat)" ;;
  esac
}

[[ "${BASH_SOURCE[0]}" == "${0}" ]] && main "$@"
